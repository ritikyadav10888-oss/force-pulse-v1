# development enables /auth/test-login (never set this in production)
NODE_ENV=development
DATABASE_URL=postgresql://forcepulse:forcepulse@localhost:5432/forcepulse
PORT=4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Required. 32+ random chars, generate with: openssl rand -hex 32
JWT_SECRET=
# OAuth Web client id (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Bootstrap super admins (Google-verified emails, comma-separated)
SUPER_ADMIN_EMAILS=
# Cloud Storage bucket for photos and ID documents (uploads fail without it)
FILES_BUCKET=

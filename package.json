{
  "name": "force-pulse",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}

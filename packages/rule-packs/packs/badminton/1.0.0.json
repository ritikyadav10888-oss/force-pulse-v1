{
  "$schema": "../../schema/rule-pack.schema.json",
  "id": "badminton",
  "version": "1.0.0",
  "name": "Badminton & other sets sports",
  "scoringModel": "sets",
  "teamSport": false,
  "registration": {
    "fields": [
      {
        "key": "discipline",
        "label": "Sport",
        "type": "select",
        "required": true,
        "options": [
          { "value": "badminton", "label": "Badminton" },
          { "value": "table_tennis", "label": "Table tennis" },
          { "value": "tennis", "label": "Tennis" },
          { "value": "volleyball", "label": "Volleyball" }
        ]
      },
      {
        "key": "eventsPlayed",
        "label": "Events played",
        "type": "multiselect",
        "required": true,
        "showIf": { "field": "discipline", "in": ["badminton", "table_tennis", "tennis"] },
        "options": [
          { "value": "singles", "label": "Singles" },
          { "value": "doubles", "label": "Doubles" },
          { "value": "mixed", "label": "Mixed doubles" }
        ]
      },
      {
        "key": "playingHand",
        "label": "Playing hand",
        "type": "select",
        "showIf": { "field": "discipline", "in": ["badminton", "table_tennis", "tennis"] },
        "options": [
          { "value": "right", "label": "Right" },
          { "value": "left", "label": "Left" }
        ]
      },
      {
        "key": "volleyballPosition",
        "label": "Volleyball position",
        "type": "select",
        "required": true,
        "showIf": { "field": "discipline", "in": ["volleyball"] },
        "options": [
          { "value": "setter", "label": "Setter" },
          { "value": "outside_hitter", "label": "Outside hitter" },
          { "value": "middle_blocker", "label": "Middle blocker" },
          { "value": "opposite", "label": "Opposite" },
          { "value": "libero", "label": "Libero" }
        ]
      },
      {
        "key": "ranking",
        "label": "Rating or ranking",
        "type": "text",
        "maxLength": 60,
        "help": "e.g. state rank 12, or club rating"
      }
    ]
  },
  "lineup": { "starters": 1, "maxSubs": 0, "squadMin": 1, "squadMax": 2 },
  "format": { "bestOf": 3, "pointsPerSet": 21, "winBy": 2, "pointCap": 30 }
}
